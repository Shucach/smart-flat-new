APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

SMARTFLAT_MEDIA_ROOT=/media/nfs
SMARTFLAT_SYSTEM_DRIVER=auto
# null refuses the action, shell runs the commands below, request-file leaves the
# request for a host unit to act on -- the only one that works from a container.
SMARTFLAT_POWER_DRIVER=null
SMARTFLAT_REBOOT_COMMAND="/usr/bin/sudo /sbin/reboot"
SMARTFLAT_SHUTDOWN_COMMAND="/usr/bin/sudo /sbin/shutdown -h now"
# SMARTFLAT_POWER_REQUEST_PATH=/var/www/sf.vanzzo.net/code/storage/app/power

# Transmission is driven through its JSON-RPC endpoint. The credentials are the
# USER/PASS the daemon container was started with -- see the compose file next
# to its config directory. Set the driver to "null" to switch the section off.
SMARTFLAT_TORRENT_DRIVER=transmission
TRANSMISSION_RPC_URL=http://127.0.0.1:9091/transmission/rpc
TRANSMISSION_RPC_USERNAME=
TRANSMISSION_RPC_PASSWORD=
TRANSMISSION_RPC_TIMEOUT=10

SMARTFLAT_FRAME_DRIVER=http
SMART_FRAME_HOST=
SMART_FRAME_KEY=
SMART_FRAME_TIMEOUT=15

# Clips are converted to the only thing the frame's GPU decodes -- H.264 at the
# panel's own 600x1024 -- on the queue, which needs ffmpeg on this machine.
# Set the driver to "null" where it is not installed.
SMARTFLAT_FRAME_VIDEO_DRIVER=ffmpeg
SMART_FRAME_VIDEO_MAX_SECONDS=60
SMART_FRAME_VIDEO_MAX_KILOBYTES=204800
